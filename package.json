{
  "name": "books-selection",
  "version": "0.2.0",
  "description": "Local desktop-style web app for browsing FB2 book series, indexing full text, and asking questions with budget-guarded AI providers.",
  "private": false,
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test tests/*.test.js",
    "build:dist": "node scripts/build-dist.js"
  },
  "keywords": [
    "fb2",
    "books",
    "ebook",
    "library",
    "accessibility",
    "nodejs"
  ],
  "devDependencies": {
    "@yao-pkg/pkg": ">=6.21.0 <7"
  },
  "bin": "src/server.js",
  "pkg": {
    "assets": [
      "public/**/*"
    ]
  }
}
